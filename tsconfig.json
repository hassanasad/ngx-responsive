{
    "compilerOptions": {
      "experimentalDecorators": true,
      "strict": true,
      "moduleResolution": "bundler",
      "module": "es2022",
      "sourceMap": true,
      "inlineSources": true,
      "declaration": true,
      "target": "ES2022",
      "skipLibCheck": true,
      "lib": [
        "ES2022",
        "dom"
      ],
      "useDefineForClassFields": false
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "examples",
        "**/*.spec.ts"
    ],
    "angularCompilerOptions": {
        "skipTemplateCodegen": true,
        "strictTemplates": true
    }
}
